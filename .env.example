# Copy to .env and fill in. Never commit .env.
# Project URL from Supabase → Project Settings → API (a /rest/v1/ suffix is fine).
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-side only.
SUPABASE_SERVICE_KEY=
# Session pooler connection string (port 5432) from Supabase → Connect.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Phase 2 slide parsing (vision path). Model and effort are optional overrides.
OPENAI_API_KEY=
# SLIDES_MODEL=gpt-6.1-sol
# SLIDES_REASONING_EFFORT=medium
# Phase 3 transcripts (optional overrides).
# TRANSCRIPT_CLEAN_MODEL=gpt-6.1-sol
# TRANSCRIPT_CLEAN_EFFORT=low
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=1536
# Phase 4: cited Q&A (EMBEDDING_DIMENSIONS must stay 1536: the chunks.embedding column)
# QA_MODEL=gpt-6.1-sol
# QA_EFFORT=low
# TUTORIAL_MODEL=gpt-6.1-sol
# TUTORIAL_EFFORT=low
